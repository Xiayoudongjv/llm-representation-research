  "moment_recalibration": {
    "name": "A_mu_sigma",
    "definition": "T_mu_sigma(h_j)_k = ((h_j,k - mu_j,k^FIT) / sigma_j,k^FIT) * sigma_i,k^FIT + mu_i,k^FIT",
    "orientation": "target_representation_to_source_measurement_frame",
    "fit_only_rule": "all_moments_from_FIT_paired_representations_only",
    "variance_convention": "population_variance_ddof_0",
    "reference_authority": "docs/experiments/EXP-024-PREREGISTRATION.md"
  },
  "operator_families": {
    "primary_conditions": [
      "T0_IDENTITY_RAW_FIXED_FRAME",
      "T1_INHERITED_MOMENT_RECALIBRATION",
      "T2_PAIRED_COORDINATEWISE_AFFINE_ALIGNMENT"
    ],
    "T0": {
      "name": "IDENTITY_RAW_FIXED_FRAME",
      "mapping": "T0(h_j) = h_j"
    },
    "T1": {
      "name": "INHERITED_MOMENT_RECALIBRATION",
      "mapping": "T_mu_sigma(h_j)_k = ((h_j,k - mu_j,k^FIT) / sigma_j,k^FIT) * sigma_i,k^FIT + mu_i,k^FIT",
      "label_free": true,
      "fit_only": true
    },
    "T2": {
      "name": "PAIRED_COORDINATEWISE_AFFINE_ALIGNMENT",
      "mapping": "T_pair_diag(h_j)_k = a_k * h_j,k + b_k",
      "fitting": "closed_form_coordinatewise_OLS_on_FIT_paired_representations",
      "label_free": true,
      "fit_only": true,
      "cross_coordinate_mixing": false,
      "hyperparameter_search": false,
      "task_loss_optimization": false
    },
    "primary_comparator": "T_pair_diag_vs_T_mu_sigma",
    "coordinatewise_only": true,
    "prohibited_families": [
      "dense_affine_matrix",
      "low_rank_cross_coordinate_map",
      "orthogonal_Procrustes",
      "MLP",
      "KAN",
      "spline_adapter",
      "attention_adapter",
      "learned_residual_network"
    ],
    "primary_comparator_baseline": "T1_MOMENT_RECALIBRATION",
    "primary_contrast": "T2_MINUS_T1"
  },
  "numerical_edge_rules": {
    "epsilon": 0.0,
    "variance_convention": "population_variance_ddof_0",
    "zero_variance_action": "TECHNICALLY_INVALID_MODEL",
    "near_zero_positive_variance_action": "COMPUTE_WITHOUT_EPSILON_AND_INVALIDATE_IF_NONFINITE",
    "nonfinite_variance_action": "TECHNICALLY_INVALID_MODEL",
    "nonfinite_covariance_action": "TECHNICALLY_INVALID_MODEL",
    "nonfinite_fitted_coefficient_action": "TECHNICALLY_INVALID_MODEL",
    "source_denominator_rule": "TECHNICALLY_INVALID_MODEL_IF_SOURCE_SIGMA_LE_0_OR_NONFINITE",
    "no_tunable_epsilon": true,
    "no_post_outcome_tuning": true
  },
  "primary_endpoints": {
    "representation_endpoint": {
      "name": "DELTA_RM",
      "definition": "DELTA_RM = E(T_mu_sigma) - E(T_pair_diag)",
      "E_definition": "mean_over_fresh_EVAL_item_and_coordinate_of_square((T(h_j)_k - h_i,k) / sigma_i,k^FIT)",
      "positive_meaning": "paired_information_improves_direct_representation_matching_beyond_marginal_recalibration",
      "sign_convention": "DELTA_RM = E(T_mu_sigma) - E(T_pair_diag); equivalently RM(T_pair_diag) - RM(T_mu_sigma) where RM(T) = -E(T); positive means paired contribution improves direct representation matching."
    },
    "readout_endpoint": {
      "name": "DELTA_RO",
      "definition": "DELTA_RO = C_pair - C_mu_sigma",
      "C_pair": "balanced_accuracy_of_frozen_source_probe_P_i_on_T_pair_diag(h_j)_fresh_EVAL",
      "C_mu_sigma": "balanced_accuracy_of_frozen_source_probe_P_i_on_T_mu_sigma(h_j)_fresh_EVAL",
      "positive_meaning": "paired_coordinate_information_contributes_fixed_readout_recovery_beyond_marginal_recalibration",
      "sign_convention": "DELTA_RO = C_pair - C_mu_sigma; positive means paired contribution improves fixed-readout recovery."
    },
    "balanced_accuracy": "macro_average_per_class_recall_over_logic_causality_analogy_definition",
    "probe_fitting": "FIT_only",
    "operator_fitting": "label_free_FIT_only",
    "no_optimize_T_pair_diag_against_DELTA_RO": true
  },
